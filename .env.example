# Google Drive — used for file uploads (leave attachments, etc). Not the database.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# NextAuth
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Postgres (Supabase) — the app's database, via Prisma.
# DATABASE_URL: pooled connection (pgbouncer, port 6543) — used by the running app.
DATABASE_URL="postgresql://<user>:<password>@<host>:6543/postgres?pgbouncer=true"
# DIRECT_URL: direct connection (port 5432) — used only for `prisma migrate`/`db push`.
# The Prisma CLI has been observed to hang against the pooled connection for schema
# commands; always pass DIRECT_URL explicitly when running one (see docs/ARCHITECTURE.md).
DIRECT_URL="postgresql://<user>:<password>@<host>:5432/postgres"
